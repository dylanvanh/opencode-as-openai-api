{
  "name": "meat-plannotator-review",
  "version": "0.1.0",
  "description": "Review Git diffs with Meat and Plannotator through an OpenCode model.",
  "type": "module",
  "bin": {
    "meat-plannotator-review": "dist/cli.js"
  },
  "files": [
    "dist",
    "scripts"
  ],
  "scripts": {
    "start": "npm run build && node dist/cli.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node -e \"require('node:fs').rmSync('.test-dist',{recursive:true,force:true})\" && tsc -p tsconfig.json --noEmit false --outDir .test-dist --rootDir . && node --test .test-dist/test/*.test.js",
    "check": "npm run typecheck && npm test",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "meat",
    "plannotator",
    "opencode",
    "code-review"
  ],
  "license": "MIT"
}

{
  "name": "meat-plannotator-review",
  "version": "0.1.0",
  "description": "Review Git diffs with Meat and Plannotator through an OpenCode model.",
  "type": "module",
  "bin": {
    "meat-plannotator-review": "dist/cli.js"
  },
  "files": [
    "dist",
    "scripts"
  ],
  "scripts": {
    "start": "bun run build && node dist/cli.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test",
    "test:e2e": "bun run --filter opencode-as-openai-api build && bun run build && bun test ./test/e2e.ts",
    "check": "bun run typecheck && bun test",
    "prepack": "bun run build"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "meat",
    "plannotator",
    "opencode",
    "code-review"
  ],
  "license": "MIT"
}

{
  "name": "opencode-as-openai-api",
  "version": "0.1.0",
  "description": "Expose any OpenCode model through an OpenAI-compatible API.",
  "type": "module",
  "bin": {
    "opencode-as-openai-api": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "npm run build && node dist/cli.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node -e \"require('node:fs').rmSync('.test-dist',{recursive:true,force:true})\" && tsc -p tsconfig.json --noEmit false --outDir .test-dist --rootDir . && node --test .test-dist/test/*.test.js",
    "check": "npm run typecheck && npm test",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "opencode",
    "openai",
    "proxy",
    "responses-api"
  ],
  "license": "MIT"
}

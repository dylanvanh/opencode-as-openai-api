{
  "name": "opencode-as-openai-api",
  "version": "0.1.0",
  "description": "Expose any OpenCode model through an OpenAI-compatible API.",
  "type": "module",
  "bin": {
    "opencode-as-openai-api": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "bun run build && node dist/cli.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test",
    "test:e2e": "bun run build && bun test ./test/e2e.ts",
    "check": "bun run typecheck && bun test",
    "prepack": "bun run build"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "opencode",
    "openai",
    "proxy",
    "responses-api"
  ],
  "license": "MIT"
}
